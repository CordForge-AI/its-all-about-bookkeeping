---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { business } from "../data/site";

const title = "Contact Us | It's All About Bookkeeping";
const description =
  "Schedule a free consultation. Tell us about your business and where your books stand today, and we'll help determine the right place to start.";

const helpOptions = [
  "Not sure yet — help me choose",
  "QuickBooks Setup",
  "Bookkeeping Cleanup",
  "Monthly Bookkeeping — Starter",
  "Monthly Bookkeeping — Standard",
  "Monthly Bookkeeping — Growth",
  "Something else",
];

const contactPoints = [
  { icon: "mail" as const, label: "Email", value: business.email, href: `mailto:${business.email}` },
  { icon: "phone" as const, label: "Phone", value: business.phone, href: business.phoneHref },
  { icon: "map-pin" as const, label: "Service area", value: business.serviceArea, href: undefined },
];
---

<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden bg-mist/40">
    <div class="pointer-events-none absolute -right-24 -top-16 h-64 w-64 rounded-full bg-purple/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 pb-16 pt-16 text-center sm:px-8 sm:pt-24">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 text-4xl leading-[1.1] text-teal-950 sm:text-5xl">Schedule a Free Consultation</h1>
      <p class="prose-body mx-auto mt-6 max-w-xl text-lg">
        Tell us a little about your business and where your books stand today. We'll follow up to talk through the
        right place to start — no pressure, no obligation.
      </p>
    </div>
    <WaveDivider color="var(--color-sand)" />
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <!--
        Netlify Forms pattern: works with zero backend when deployed on Netlify.
        If hosting elsewhere, swap the submit handler for the chosen form
        provider (Formspree, a serverless function, etc.) — see data-netlify
        attributes and the fetch() call in the script below.
      -->
      <div class="rounded-[2rem] border border-teal-950/8 bg-sand p-7 shadow-soft sm:p-10">
        <form
          id="contact-form"
          name="contact-inquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="company"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact-inquiry" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="company" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="text-sm font-semibold text-teal-950">Full name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
              />
            </div>
            <div>
              <label for="email" class="text-sm font-semibold text-teal-950">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="business" class="text-sm font-semibold text-teal-950">Business name</label>
              <input
                id="business"
                name="business"
                type="text"
                autocomplete="organization"
                class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
              />
            </div>
            <div>
              <label for="phone" class="text-sm font-semibold text-teal-950">Phone <span class="font-normal text-teal-950/70">(optional)</span></label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
              />
            </div>
          </div>

          <div>
            <label for="interest" class="text-sm font-semibold text-teal-950">How can we help?</label>
            <select
              id="interest"
              name="interest"
              class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
            >
              {helpOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="text-sm font-semibold text-teal-950">Tell us about your business</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="A few sentences about your business and where your books stand today is a great place to start."
              class="mt-1.5 w-full rounded-xl border border-teal-950/15 bg-white px-4 py-2.5 text-sm text-teal-950 outline-none focus:border-sky focus:ring-2 focus:ring-sky/40"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">
            <span data-submit-label>Send Message</span>
          </button>

          <p role="status" aria-live="polite" data-form-status class="hidden rounded-xl px-4 py-3 text-sm"></p>
        </form>
      </div>

      <div class="space-y-6">
        <div class="rounded-[1.75rem] border border-teal-950/8 bg-mist/40 p-7">
          <h2 class="text-lg text-teal-950">Get in touch directly</h2>
          <ul class="mt-5 space-y-4">
            {
              contactPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sand text-teal-950">
                    <Icon name={point.icon} class="h-5 w-5" />
                  </span>
                  <div class="pt-1.5">
                    <p class="text-xs font-bold uppercase tracking-wide text-teal-950/70">{point.label}</p>
                    {point.href ? (
                      <a href={point.href} class="text-sm font-semibold text-teal-950 hover:text-purple-dark">
                        {point.value}
                      </a>
                    ) : (
                      <p class="text-sm font-semibold text-teal-950">{point.value}</p>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-[1.75rem] bg-teal-950 p-7 text-sand">
          <Icon name="waves" class="h-6 w-6 text-sky" />
          <p class="mt-4 text-sm leading-relaxed text-sand/85">
            Not sure which service fits? That's exactly what the free consultation is for — we'll ask a few
            questions and point you in the right direction.
          </p>
          <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-ghost mt-5 text-sand decoration-purple hover:text-purple">
            View pricing first <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = form?.querySelector("[data-form-status]") as HTMLElement | null;
  const submitLabel = form?.querySelector("[data-submit-label]") as HTMLElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !submitLabel) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitButton?.setAttribute("disabled", "true");
    submitLabel.textContent = "Sending…";
    status.classList.add("hidden");

    const data = new FormData(form);

    try {
      const response = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });

      if (!response.ok) throw new Error("Submission failed");

      form.reset();
      form.classList.add("hidden");
      status.textContent = "Thanks — your message is on its way. We'll be in touch soon.";
      status.classList.remove("hidden");
      status.classList.add("bg-mist/60", "text-teal-950");
    } catch {
      submitButton?.removeAttribute("disabled");
      submitLabel.textContent = "Send Message";
      status.textContent = "Something went wrong sending your message. Please try again, or email us directly.";
      status.classList.remove("hidden");
      status.classList.add("bg-purple/15", "text-purple-dark");
    }
  });
</script>
