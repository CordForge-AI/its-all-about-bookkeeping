---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WaveDivider from "../components/WaveDivider.astro";
import {
  oneTimeServices,
  monthlyPackages,
  packageComparison,
  cleanupPricingGuide,
  pricingTransparencyNote,
  serviceScopeNote,
} from "../data/site";

const title = "Bookkeeping Pricing & Monthly Packages | It's All About Bookkeeping";
const description =
  "Explore straightforward bookkeeping pricing for QuickBooks setup, bookkeeping cleanup, and monthly bookkeeping packages for small businesses.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-mist/40">
    <div class="pointer-events-none absolute -right-20 -top-16 h-64 w-64 rounded-full bg-coral/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-16 text-center sm:px-8 sm:pt-24">
      <p class="eyebrow">Pricing</p>
      <h1 class="mt-4 text-4xl leading-[1.1] text-teal-950 sm:text-5xl">Straightforward Bookkeeping Pricing</h1>
      <p class="prose-body mx-auto mt-6 max-w-2xl text-lg">
        Simple bookkeeping options designed around where your business is today — whether you're getting started,
        catching up, or looking for reliable monthly support.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary">
          Schedule a Free Consultation
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href="#monthly-packages" class="btn-secondary">View Monthly Packages</a>
      </div>
    </div>
    <WaveDivider color="var(--color-sand)" />
  </section>

  <!-- One-time services -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Getting started or catching up</p>
      <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Need Help Getting Started or Caught Up?</h2>
      <p class="prose-body mt-4 text-base">
        Start with the foundation your business needs before moving into ongoing monthly bookkeeping.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        oneTimeServices.map((service) => (
          <div class="flex flex-col rounded-[1.75rem] border border-teal-950/8 bg-sand p-8 shadow-soft">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-teal-950">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-6 text-2xl text-teal-950">{service.name}</h3>
            <p class="mt-1 text-lg font-semibold text-coral-dark">{service.startingAt}</p>
            <p class="prose-body mt-3 text-sm">{service.summary}</p>

            <ul class="mt-5 space-y-2.5">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-teal-950/85">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-seafoam-deep" />
                  {item}
                </li>
              ))}
            </ul>

            {service.note && (
              <p class="mt-5 rounded-xl bg-mist/50 px-4 py-3 text-xs leading-relaxed text-teal-950/70">
                {service.note}
              </p>
            )}

            <a href={`${import.meta.env.BASE_URL}contact`} class="btn-secondary mt-6 self-start">{service.cta}</a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Monthly bookkeeping packages -->
  <section id="monthly-packages" class="scroll-mt-20 bg-sand-dark/60 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow">Ongoing support</p>
        <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Monthly Bookkeeping</h2>
        <p class="prose-body mt-4 text-base">
          Consistent bookkeeping designed to keep your records accurate, organized, and easier to understand every
          month.
        </p>
      </div>

      <div class="mt-12 grid gap-10 sm:gap-0 lg:grid-cols-3">
        {
          monthlyPackages.map((pkg, i) => (
            <div
              class={`flex flex-col px-0 py-4 lg:px-9 lg:py-0 ${
                i > 0 ? "border-t border-teal-950/12 pt-8 lg:border-l lg:border-t-0 lg:pt-4" : ""
              }`}
            >
              <h3 class="font-heading text-2xl text-teal-950">{pkg.name}</h3>
              <p class="mt-2 font-heading text-4xl text-teal-950">{pkg.price}</p>
              <p class="mt-3 text-sm font-semibold text-coral-dark">{pkg.bestFor}</p>

              <ul class="mt-6 flex-1 space-y-2.5">
                {pkg.includes.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-teal-950/85">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-seafoam-deep" />
                    {item}
                  </li>
                ))}
              </ul>

              <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary mt-7 w-full sm:w-auto">{pkg.cta}</a>
            </div>
          ))
        }
      </div>

      <!-- Quick comparison -->
      <div class="mt-14 rounded-[1.75rem] border border-teal-950/8 bg-sand p-8 sm:p-10">
        <h3 class="text-xl text-teal-950">At a glance</h3>
        <p class="prose-body mt-1 text-sm">Why the packages cost differently, in a few words.</p>
        <div class="mt-6 grid gap-8 sm:grid-cols-3">
          {
            packageComparison.map((pkg) => (
              <div>
                <p class="font-heading text-lg text-teal-950">{pkg.name}</p>
                <ul class="mt-3 space-y-1.5">
                  {pkg.points.map((point) => (
                    <li class="text-sm text-teal-950/75">{point}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Cleanup pricing guide -->
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Cleanup guide</p>
      <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Bookkeeping Cleanup Pricing Guide</h2>
      <p class="prose-body mt-4 text-base">
        Every cleanup is different. Pricing depends on how far behind the books are, transaction volume, account
        complexity, and the current condition of the records.
      </p>
    </div>

    <div class="mt-10 overflow-hidden rounded-[1.75rem] border border-teal-950/8 bg-sand">
      {
        cleanupPricingGuide.map((tier, i) => (
          <div
            class={`flex flex-col gap-1 px-7 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-9 ${
              i > 0 ? "border-t border-teal-950/8" : ""
            }`}
          >
            <div class="flex items-center gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-mist font-heading text-sm text-teal-950">
                {i + 1}
              </span>
              <p class="text-base font-semibold text-teal-950">{tier.range}</p>
            </div>
            <p class="pl-13 font-heading text-xl text-coral-dark sm:pl-0">{tier.price}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a href={`${import.meta.env.BASE_URL}contact`} class="btn-secondary">Request a Cleanup Review</a>
    </div>
  </section>

  <!-- Help me choose -->
  <section class="mx-auto max-w-5xl px-5 pb-4 sm:px-8">
    <div class="rounded-[2rem] bg-teal-950 px-8 py-12 text-center text-sand sm:px-14 sm:py-16">
      <h2 class="text-3xl sm:text-4xl">Not Sure Which Option Fits?</h2>
      <p class="mx-auto mt-4 max-w-xl text-sand/75">
        You don't need to figure it out on your own. Tell us a little about your business and where your books
        stand today, and we'll help determine the right place to start.
      </p>
      <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary mt-7">
        Schedule a Free Consultation
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <!-- Transparency + scope notes -->
  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
    <div class="rounded-2xl border border-seafoam/30 bg-mist/40 px-6 py-5 sm:px-8">
      <div class="flex items-start gap-3">
        <Icon name="shield-check" class="mt-0.5 h-5 w-5 shrink-0 text-teal-950/70" />
        <p class="text-sm leading-relaxed text-teal-950/75">{pricingTransparencyNote}</p>
      </div>
    </div>

    <p class="mt-6 text-xs leading-relaxed text-teal-950/70">{serviceScopeNote}</p>
  </section>
</BaseLayout>
