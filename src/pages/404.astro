---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const title = "Page Not Found | It's All About Bookkeeping";
const description = "The page you're looking for can't be found.";
---

<BaseLayout title={title} description={description} noindex>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-24 text-center sm:px-8 sm:py-32">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-mist text-teal-950">
      <Icon name="compass" class="h-8 w-8" />
    </span>
    <p class="eyebrow mt-6">404</p>
    <h1 class="mt-3 text-4xl text-teal-950 sm:text-5xl">We couldn't find that page</h1>
    <p class="prose-body mt-5 max-w-md">
      The page you're looking for may have moved or no longer exists. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={import.meta.env.BASE_URL} class="btn-primary">Back to Home</a>
      <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-secondary">View Pricing</a>
    </div>
  </section>
</BaseLayout>
