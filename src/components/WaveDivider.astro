---
interface Props {
  color?: string;
  flip?: boolean;
  class?: string;
}

const { color = "var(--color-mist)", flip = false, class: className = "" } = Astro.props;
---

<div class={`pointer-events-none overflow-hidden leading-[0] ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 1440 90"
    class={`h-auto w-full ${flip ? "-scale-y-100" : ""}`}
    preserveAspectRatio="none"
  >
    <path
      fill={color}
      d="M0,32 C240,80 480,0 720,24 C960,48 1200,88 1440,40 L1440,90 L0,90 Z"
    ></path>
  </svg>
</div>
