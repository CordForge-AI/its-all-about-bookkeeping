---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { oneTimeServices, monthlyPackages } from "../data/site";

const title = "Bookkeeping Services | QuickBooks Setup, Cleanup & Monthly Bookkeeping";
const description =
  "QuickBooks setup, bookkeeping cleanup, and monthly bookkeeping packages for small businesses — organized records, clear reporting, and dependable monthly support.";

const included = [
  { icon: "calculator" as const, title: "QuickBooks Online", body: "We work exclusively in QuickBooks Online for accuracy and consistency." },
  { icon: "trending-up" as const, title: "Clear reporting", body: "Profit & Loss and Balance Sheet reports you can actually read." },
  { icon: "calendar" as const, title: "Monthly reconciliations", body: "Bank and credit card accounts reconciled every month, on schedule." },
  { icon: "mail" as const, title: "Responsive support", body: "Email support on every plan, with priority support on Growth." },
];
---

<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden bg-mist/40">
    <div class="pointer-events-none absolute -left-24 -top-16 h-64 w-64 rounded-full bg-sky/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-16 text-center sm:px-8 sm:pt-24">
      <p class="eyebrow">Services</p>
      <h1 class="mt-4 text-4xl leading-[1.1] text-teal-950 sm:text-5xl">Bookkeeping Support for Every Stage</h1>
      <p class="prose-body mx-auto mt-6 max-w-2xl text-lg">
        Whether you're setting up QuickBooks for the first time, catching up on months of records, or looking for
        dependable monthly support, we meet your business where it is.
      </p>
      <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-primary mt-8">
        See Pricing & Packages
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <WaveDivider color="var(--color-sand)" />
  </section>

  <!-- One-time services -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">Getting started or catching up</p>
      <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">One-Time Services</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        oneTimeServices.map((service) => (
          <div class="flex flex-col rounded-[1.75rem] border border-teal-950/8 bg-sand p-8 shadow-soft">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-teal-950">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-6 text-2xl text-teal-950">{service.name}</h3>
            <p class="mt-1 text-lg font-semibold text-purple-dark">{service.startingAt}</p>
            <p class="prose-body mt-3 text-sm">{service.summary}</p>
            <ul class="mt-5 space-y-2.5">
              {service.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-teal-950/85">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-sky-deep" />
                  {item}
                </li>
              ))}
            </ul>
            <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-ghost mt-6">
              Full pricing details <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Monthly bookkeeping -->
  <section class="bg-sand-dark/60 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow">Ongoing support</p>
        <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Monthly Bookkeeping</h2>
        <p class="prose-body mt-4 text-base">
          Three packages built around transaction volume and the number of accounts your business uses — so you
          only pay for the level of support you need.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          monthlyPackages.map((pkg) => (
            <div class="flex flex-col rounded-[1.75rem] border border-teal-950/8 bg-sand p-7">
              <h3 class="font-heading text-xl text-teal-950">{pkg.name}</h3>
              <p class="mt-1 font-heading text-2xl text-teal-950">{pkg.price}</p>
              <p class="mt-2 text-sm font-semibold text-purple-dark">{pkg.bestFor}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {pkg.includes.slice(0, 4).map((item) => (
                  <li class="flex items-start gap-2 text-sm text-teal-950/80">
                    <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-sky-deep" />
                    {item}
                  </li>
                ))}
              </ul>
              <a href={`${import.meta.env.BASE_URL}pricing#monthly-packages`} class="btn-ghost mt-5">
                Full details <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          ))
        }
      </div>

      <div class="mt-8 text-center">
        <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-primary">
          Compare All Packages
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">What to expect</p>
      <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Built-in on every engagement</h2>
    </div>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        included.map((item) => (
          <div>
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-mist text-teal-950">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-teal-950">{item.title}</h3>
            <p class="prose-body mt-1.5 text-sm">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-8">
    <div class="rounded-[2rem] bg-mist/60 px-8 py-12 text-center sm:px-14 sm:py-16">
      <h2 class="text-3xl text-teal-950 sm:text-4xl">Not sure where to start?</h2>
      <p class="prose-body mx-auto mt-4 max-w-xl">
        A free consultation is the fastest way to find the right fit — no pressure, no obligation.
      </p>
      <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary mt-7">
        Schedule a Free Consultation
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
