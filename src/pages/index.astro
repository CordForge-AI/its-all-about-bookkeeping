---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveDivider from "../components/WaveDivider.astro";
import Icon from "../components/Icon.astro";
import { business, oneTimeServices, monthlyPackages, faqs } from "../data/site";

const title = "It's All About Bookkeeping | Small Business Bookkeeping Services";
const description =
  "Clear numbers, confident business. QuickBooks setup, bookkeeping cleanup, and monthly bookkeeping packages built around where your business is today.";

const valueProps = [
  {
    icon: "compass" as const,
    title: "Clarity, not clutter",
    body: "Your books, organized in plain language — so you always know where your business stands.",
  },
  {
    icon: "shield-check" as const,
    title: "Consistent & dependable",
    body: "Monthly reconciliations and reporting on a rhythm you can count on, every month.",
  },
  {
    icon: "heart" as const,
    title: "Approachable support",
    body: "No jargon, no judgment about where your books stand today — just steady, human help.",
  },
];

const steps = [
  {
    title: "Schedule a free consultation",
    body: "Tell us about your business and where your books stand today.",
  },
  {
    title: "Get a recommendation",
    body: "We'll suggest QuickBooks setup, a cleanup, or the monthly package that fits.",
  },
  {
    title: "Get organized",
    body: "We build or clean up your books so everything is accurate and ready to go.",
  },
  {
    title: "Stay on track",
    body: "Ongoing monthly bookkeeping keeps your numbers current, reconciled, and easy to understand.",
  },
];

const previewFaqs = faqs.slice(0, 4);
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-mist/40">
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-coral/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-32 top-40 h-64 w-64 rounded-full bg-seafoam/20 blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 pb-20 pt-16 sm:px-8 sm:pt-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:pb-28">
      <div>
        <p class="eyebrow">{business.tagline}</p>
        <h1 class="mt-4 text-4xl leading-[1.08] text-teal-950 sm:text-5xl lg:text-[3.4rem]">
          Bookkeeping That Fits Your Business
        </h1>
        <p class="prose-body mt-6 max-w-xl text-lg">
          Choose the level of support that fits your business today. If you're unsure where to start, we'll help you figure it out.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary">
            Schedule a Free Consultation
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={`${import.meta.env.BASE_URL}pricing`} class="btn-secondary">View Monthly Packages</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md">
        <div class="rounded-[2rem] border border-teal-950/10 bg-sand p-7 shadow-lift sm:p-8">
          <p class="eyebrow">At a glance</p>
          <ul class="mt-5 space-y-4">
            {
              [
                { icon: "calculator" as const, text: "QuickBooks setup, done right from day one" },
                { icon: "clipboard-check" as const, text: "Cleanup for books that have fallen behind" },
                { icon: "trending-up" as const, text: "Monthly bookkeeping that scales with you" },
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-mist text-teal-950">
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <span class="pt-2 text-sm font-medium text-teal-950/85">{item.text}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 flex items-center gap-2 rounded-2xl bg-teal-950 px-4 py-3 text-sand">
            <Icon name="waves" class="h-5 w-5 text-seafoam-deep" />
            <p class="text-sm font-semibold">{business.mission}</p>
          </div>
        </div>
        <div class="absolute -right-5 -top-5 hidden h-16 w-16 items-center justify-center rounded-full bg-coral text-sand shadow-soft sm:flex" aria-hidden="true">
          <Icon name="heart" class="h-6 w-6" />
        </div>
      </div>
    </div>

    <WaveDivider color="var(--color-sand)" />
  </section>

  <!-- Value props -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      {
        valueProps.map((item) => (
          <div class="rounded-2xl border border-teal-950/8 bg-white/60 p-7">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-teal-950">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>
            <h2 class="mt-5 text-xl text-teal-950">{item.title}</h2>
            <p class="prose-body mt-2 text-sm">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services overview -->
  <section class="bg-sand-dark/60 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Wherever you're starting, there's a place to begin</h2>
        <p class="prose-body mt-4 text-base">
          From a first-time QuickBooks setup to ongoing monthly bookkeeping, we meet your business where it is.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          oneTimeServices.map((service) => (
            <a
              href={`${import.meta.env.BASE_URL}services`}
              class="group flex flex-col rounded-2xl border border-teal-950/8 bg-sand p-7 shadow-soft transition-shadow hover:shadow-lift"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-teal-950">
                <Icon name={service.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-xl text-teal-950">{service.name}</h3>
              <p class="mt-1 text-sm font-semibold text-coral-dark">{service.startingAt}</p>
              <p class="prose-body mt-3 text-sm">{service.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-950 group-hover:text-coral-dark">
                Learn more <Icon name="arrow-right" class="h-4 w-4" />
              </span>
            </a>
          ))
        }

        <a
          href={`${import.meta.env.BASE_URL}pricing`}
          class="group flex flex-col rounded-2xl border border-teal-950/8 bg-teal-950 p-7 text-sand shadow-soft transition-shadow hover:shadow-lift"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-seafoam/25 text-seafoam-light">
            <Icon name="trending-up" class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-xl">Monthly Bookkeeping</h3>
          <p class="mt-1 text-sm font-semibold text-coral">From $200/month</p>
          <p class="mt-3 text-sm leading-relaxed text-sand/75">
            Consistent bookkeeping that keeps your records accurate, organized, and easy to understand every month.
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-sand group-hover:text-coral">
            See packages & pricing <Icon name="arrow-right" class="h-4 w-4" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">A simple path to organized books</h2>
    </div>

    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="relative">
            <span class="font-heading text-4xl text-seafoam/60">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 text-lg text-teal-950">{step.title}</h3>
            <p class="prose-body mt-1.5 text-sm">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Mission band -->
  <section class="relative bg-teal-950 py-16 text-sand sm:py-20">
    <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
      <Icon name="waves" class="mx-auto h-8 w-8 text-seafoam-deep" />
      <p class="mt-5 text-2xl leading-snug sm:text-3xl">{business.mission}</p>
      <p class="mx-auto mt-4 max-w-xl text-sm text-sand/70">{business.serviceArea}</p>
    </div>
  </section>

  <!-- FAQ preview -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-3xl text-teal-950 sm:text-4xl">Common questions</h2>
        <p class="prose-body mt-4 text-sm">
          Have a different question? Visit the full FAQ or reach out directly.
        </p>
        <a href={`${import.meta.env.BASE_URL}faq`} class="btn-ghost mt-5">
          View all FAQs <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="divide-y divide-teal-950/10 rounded-2xl border border-teal-950/8 bg-sand">
        {
          previewFaqs.map((item) => (
            <details class="group px-6 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-teal-950">
                {item.question}
                <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-seafoam-deep transition-transform group-open:rotate-180" />
              </summary>
              <p class="prose-body mt-3 text-sm">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-8">
    <div class="rounded-[2rem] bg-mist/60 px-8 py-12 text-center sm:px-14 sm:py-16">
      <h2 class="text-3xl text-teal-950 sm:text-4xl">Ready for clear numbers?</h2>
      <p class="prose-body mx-auto mt-4 max-w-xl">
        Tell us a little about your business and where your books stand today, and we'll help determine the right place to start.
      </p>
      <a href={`${import.meta.env.BASE_URL}contact`} class="btn-primary mt-7">
        Schedule a Free Consultation
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
